# ==============================================================================
# Self-Evolving Autonomous Research Agent
# Environment Variables Template (Production & Hackathon Deployment)
# ==============================================================================
# Copy this file to .env in production and fill in secret values.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application & Host Settings
# ------------------------------------------------------------------------------
APP_NAME="Self-Evolving Autonomous Research Agent"
APP_ENV=production          # development | staging | production
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ------------------------------------------------------------------------------
# Backend (FastAPI)
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-me-to-a-long-random-secret-key
FRONTEND_URL=https://your-deployed-frontend.vercel.app
ALLOWED_ORIGINS=https://your-deployed-frontend.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# Frontend (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=https://your-deployed-backend.onrender.com
VITE_WS_BASE_URL=wss://your-deployed-backend.onrender.com
VITE_APP_NAME="Research Agent"
VITE_USE_MOCK_DATA=false

# ------------------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=research_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgresql+asyncpg://postgres:change-me-postgres-password@postgres-host:5432/research_agent

# ------------------------------------------------------------------------------
# ChromaDB (Vector Database)
# ------------------------------------------------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=research_embeddings

# ------------------------------------------------------------------------------
# External AI & Search APIs
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
GOOGLE_API_KEY=your-google-ai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# ------------------------------------------------------------------------------
# Sandbox & Research Agent Tuning Knobs
# ------------------------------------------------------------------------------
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_QUOTA=50000

MAX_RESEARCH_ITERATIONS=5
MAX_CONCURRENT_RESEARCH_TASKS=3
RESEARCH_TIMEOUT_SECONDS=300
PLANNER_MAX_STEPS=10
GOVERNANCE_STRICT_MODE=true
EVALUATION_CONFIDENCE_THRESHOLD=0.75

# ------------------------------------------------------------------------------
# WebSocket / SSE Configuration
# ------------------------------------------------------------------------------
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_MAX_CONNECTIONS=100
