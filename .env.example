# ==============================================================================
# Self-Evolving Autonomous Research Agent
# Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
APP_NAME="Self-Evolving Autonomous Research Agent"
APP_ENV=development         # development | staging | production
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ------------------------------------------------------------------------------
# Backend (FastAPI)
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-long-random-secret-key
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Frontend (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_APP_NAME="Research Agent"

# ------------------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=research_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgresql+asyncpg://postgres:change-me-postgres-password@localhost:5432/research_agent

# ------------------------------------------------------------------------------
# ChromaDB (Vector Database)
# ------------------------------------------------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=research_embeddings

# ------------------------------------------------------------------------------
# LLM / AI Provider
# (To be configured when LangGraph / LangChain is integrated)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
GOOGLE_API_KEY=your-google-ai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# Tavily Search API
# (To be configured when the Browser/Search module is implemented)
# ------------------------------------------------------------------------------
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# ------------------------------------------------------------------------------
# Sandbox (Docker)
# (To be configured when the Sandbox module is implemented)
# ------------------------------------------------------------------------------
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_QUOTA=50000

# ------------------------------------------------------------------------------
# Research Agent Configuration
# (Default knobs for the orchestrator — to be tuned during implementation)
# ------------------------------------------------------------------------------
MAX_RESEARCH_ITERATIONS=5
MAX_CONCURRENT_RESEARCH_TASKS=3
RESEARCH_TIMEOUT_SECONDS=300
PLANNER_MAX_STEPS=10
GOVERNANCE_STRICT_MODE=true
EVALUATION_CONFIDENCE_THRESHOLD=0.75

# ------------------------------------------------------------------------------
# WebSocket / SSE
# ------------------------------------------------------------------------------
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_MAX_CONNECTIONS=100
